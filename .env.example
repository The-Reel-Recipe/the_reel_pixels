# ═══════════════════════════════════════════════════════════════
# S37 — shakhbat 3al 7eet · environment
#
# Copy to .env for a real deploy (the process reads the environment,
# not this file — systemd EnvironmentFile= or your host's UI).
#
#   required   config.js refuses to boot with NODE_ENV=production
#              without it, from the phase noted in brackets
#   optional   safe default in dev, sensible default in prod
# ═══════════════════════════════════════════════════════════════

# ── process ──────────────────────────────────────────────────────
# optional · port to listen on. `node server.js 5174` overrides it.
PORT=5174

# optional · production turns on the fail-fast checks below.
NODE_ENV=development

# optional · prototype-era state. Nothing writes here any more: the
# wall lives in SQLite (DATA_DIR). A .wall.bin left in this directory
# is imported once into a virgin database and then left untouched.
STATE_DIR=

# optional · the database and everything filed beside it —
# pixels.db, archive/YYYY-MM.png, backup/. Defaults to ./data locally
# and a temp dir on Vercel (per-instance, gone on a cold start — the
# reason §1 of the plan moves the deploy to a VPS). On the VPS point
# it at the persistent volume, and give litestream the same path.
DATA_DIR=

# optional · read the caller's IP from CF-Connecting-IP /
# X-Forwarded-For. ONLY set this when something you control actually
# terminates in front of the process (Caddy, Cloudflare) — otherwise
# anyone can spoof the header and mint themselves unlimited pixels.
# Set automatically on Vercel.
TRUST_PROXY=0

# optional · 0 disables /api/dev/* (do this in prod; the routes are
# deleted outright in Phase 7).
DEV=1

# optional · CORS origin for a statically hosted page pointing at this
# API. Removed at hardening — same-origin only once we own the domain.
ALLOW_ORIGIN=

# ── identity (§3) ────────────────────────────────────────────────
# optional · mark the session cookie Secure, so it is only ever sent
# over HTTPS. Defaults to on in production and off everywhere else —
# a Secure cookie on a plain-http dev server is invisible to the
# browser, which looks exactly like "the login does nothing".
COOKIE_SECURE=

# optional · the per-IP daily caps. A visitor who clears their cookie
# gets a new identity and a fresh 20 free pixels, so minting is
# rationed; claims are rationed on top of that. Brands are exempt from
# the claim cap. These move into the runtime config table in Phase 6 —
# until then, an env var and a restart.
IP_GUEST_CAP=5
IP_CLAIM_CAP=40
IP_SIGNUP_CAP=3

# ── secrets ──────────────────────────────────────────────────────
# required [Phase 2] · HMAC key for guest + brand cookies. 32+ random
# bytes: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# Rotating it logs everyone out. Dev falls back to a known-insecure
# constant and warns at boot.
SESSION_SECRET=

# required [Phase 4] · BotFather token for the moderation bot.
TG_BOT_TOKEN=
# required [Phase 4] · the private moderation group (negative id).
TG_CHAT_ID=
# required [Phase 4] · shared secret checked against the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call.
TG_WEBHOOK_SECRET=
# required [Phase 4] · comma-separated Telegram user ids allowed to
# press Approve/Reject — defence in depth beyond group membership.
TG_MOD_IDS=
# optional · webhook (prod) | poll (local, no tunnel needed) |
# off (log cards to the console and auto-approve after 2s).
# Defaults to webhook in production, off everywhere else.
TG_MODE=off

# required [Phase 5] · the InstaPay payment link shown to payers.
INSTAPAY_URL=https://ipn.eg/S/mohaby/instapay/0Nif30

# required [Phase 4] · public origin, for webhook registration and the
# links on moderation cards. No trailing slash.
PUBLIC_URL=

# optional · comma-separated CIDRs allowed to reach /admin at all.
# Empty means "any IP" (password + mandatory TOTP still apply).
ADMIN_IP_ALLOW=
